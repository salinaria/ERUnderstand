erDiagram
User {
  string user_id PK
  string username
  string password_hash
  string status
}

Call {
  string call_id PK
  string start_time
  string end_time
  string call_type
}

Message {
  string message_id PK
  string timestamp
  string content
}

Device {
  string device_id PK
  string device_type
  string model
  string location
}

Recording {
  string recording_id PK
  string file_path
  %% resolution: composite
  string resolution
}

