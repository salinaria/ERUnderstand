erDiagram
Carpet {
  string carpet_id PK
  string material
  string size
}

Room {
  string room_id PK
  string room_name
  string floor_type
}

VacuumCleaner {
  string vacuum_id PK
  string model
  %% power: composite
  string power
  string bag_capacity
}

VacuumingSession {
  string session_id PK
  string date
  string duration
  string dirt_collected
}

MaintenanceLog {
  string log_id PK
  string date
  string description
  string cost
}

    Room ||--o{ Carpet : "contains"
    VacuumCleaner ||--o{ VacuumingSession : "used_in"
