    VacuumCleaner ||--o{ MaintenanceLog : "undergoes"
REL_triggers {
  string rel_triggers_id PK
}

    VacuumingSession o{..o{ REL_triggers : "VacuumingSession-REL_triggers"
    MaintenanceLog ||..o{ REL_triggers : "MaintenanceLog-REL_triggers"
    VacuumCleaner ||..o{ REL_triggers : "VacuumCleaner-REL_triggers"