    Sale ||--o{ Customer : "Purchases"
REL_Includes {
  string rel_includes_id PK
}

    Product o{..o{ REL_Includes : "Product-REL_Includes"
    Sale ||..o{ REL_Includes : "Sale-REL_Includes"
    Customer ||..o{ REL_Includes : "Customer-REL_Includes"
    Market_Stall ||--o{ Sale : "Occurs_at"