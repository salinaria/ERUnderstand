  string patient_id PK
  string name
  string date_of_birth
  string address
}

Vaccine {
  string vaccine_id PK
  string name
  string manufacturer
  string dosage
}

Appointment {
  string appointment_id PK
  string date
  string time
  string status
}

HealthcareWorker {
  string worker_id PK
  %% name: composite
  string name
  string specialization
}

Location {
  string location_id PK
  string name
  string address
  string capacity
}

    Patient ||--o{ Appointment : "schedules"
